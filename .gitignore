# ==============================================================================
# Custom Project Outputs
# ==============================================================================
# Exclude the generated redistributable archive
RhinoThumbs.NET-Windows-x64.zip
*.zip
*.7z

# Ignore the compiled openNURBS/Thumbnail extractor executables inside the tree 
# (if they shouldn't be tracked) unless "Tools/ThumbnailExtractorCLI.exe" is explicitly added.
# For now, we assume Tools/ThumbnailExtractorCLI.exe and Tools/7za.exe ARE source controlled,
# but we shouldn't track random EXEs in the root or native build dirs.
native_src/build/**/*.exe
native_src/build/**/*.dll
native_src/build/**/*.lib
