<Window x:Class="RhinoThumbs.NET.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RhinoThumbs.NET.ViewModels"
        mc:Ignorable="d"
        Title="Rhino 3dm Viewer" Height="800" Width="1200"
        Background="#1E1E1E" Foreground="#E0E0E0">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>
        
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:FileSystemItemViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                        <MenuItem Header="Open in Explorer" Command="{Binding PlacementTarget.Tag.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="Compress to 7z" Command="{Binding PlacementTarget.Tag.Compress7zCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <TextBlock Text="📁" Margin="0,0,5,0" Foreground="#FFC66D"/>
                <TextBlock Text="{Binding DisplayName}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:ThumbnailItemViewModel}">
            <Border Width="200" Height="240" Margin="10" Background="#2D2D30" CornerRadius="4" BorderBrush="#3E3E42" BorderThickness="1" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="Open in Explorer" Command="{Binding PlacementTarget.Tag.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <Separator/>
                            <MenuItem Header="Compress to 7z" Command="{Binding PlacementTarget.Tag.Compress7zCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Thumbnail -->
                        <Grid Grid.Row="0" Margin="5">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Loading..." Foreground="#808080" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>

                        <!-- Metadata -->
                        <StackPanel Grid.Row="1" Margin="5" Background="#252526">
                            <TextBlock Text="{Binding FileName}" Foreground="White" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding DateModified}" Foreground="#808080" FontSize="10"/>
                                <TextBlock Text="{Binding FileSize}" Foreground="#808080" FontSize="10" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
            </Border>
        </DataTemplate>
        
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation Pane -->
        <Grid Grid.Column="0" Background="#252526">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Folders" Margin="10" FontWeight="Bold" Foreground="#808080"/>
            <TreeView Grid.Row="1" ItemsSource="{Binding Drives}">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Grid>

        <!-- Grid Splitter 1 -->
        <GridSplitter Grid.Column="0" Width="2" Background="#3E3E42" HorizontalAlignment="Right" VerticalAlignment="Stretch"/>

        <!-- Content Pane -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <Border Grid.Row="0" Background="#2D2D30" Padding="10,5" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
                <Grid HorizontalAlignment="Left" Width="300" Background="#1E1E1E">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Search files..." Foreground="#808080" Margin="5,0,0,0" VerticalAlignment="Center" FontStyle="Italic" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="SearchBox" Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="White" BorderThickness="0" VerticalAlignment="Center" Padding="5,4" ToolTip="Search recursively"/>
                    
                    <Button Grid.Column="1" Content="✕" Command="{Binding ClearSearchCommand}" Width="24" Height="24" Background="Transparent" Foreground="#808080" BorderThickness="0" Cursor="Hand" Margin="0,0,2,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Thumbnails -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent" BorderThickness="0"
                     Tag="{Binding}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding Tag.OpenViewerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#3E3E42"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2D2D30"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="#007ACC" Padding="10,5">
                <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <!-- Grid Splitter 2 -->
        <GridSplitter Grid.Column="1" Width="2" Background="#3E3E42" HorizontalAlignment="Right" VerticalAlignment="Stretch"/>

        <!-- Preview Pane -->
        <Grid Grid.Column="2" Background="#252526" DataContext="{Binding SelectedFile}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="Preview" Margin="10" FontWeight="Bold" Foreground="#808080"/>

            <!-- Large Preview Image -->
            <Border Grid.Row="1" Margin="10" BorderBrush="#3E3E42" BorderThickness="1" Background="#1E1E1E">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
            </Border>

            <!-- Detailed Metadata -->
            <StackPanel Grid.Row="2" Margin="10">
                <TextBlock Text="{Binding FileName}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding FilePath}" Foreground="#808080" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,10"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:" Foreground="#808080" Margin="0,0,10,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FileSize}"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Modified:" Foreground="#808080" Margin="0,0,10,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DateModified}"/>
                </Grid>
            </StackPanel>
            
            <!-- Placeholder when no selection -->
            <TextBlock Grid.Row="1" Text="Select a file to preview" Foreground="#505050" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse, RelativeSource={RelativeSource AncestorType=Grid}, Path=DataContext, TargetNullValue=Visible, FallbackValue=Visible}"/>
        </Grid>
    </Grid>
</Window>
