<Window x:Class="RhinoThumbs.NET.Views.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf"
        Title="3D Preview" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">
    <Grid>
        <hx:HelixViewport3D x:Name="Viewport3D" 
                            ZoomExtentsWhenLoaded="True" 
                            ShowCoordinateSystem="True"
                            ShowViewCube="True"
                            ModelUpDirection="0,0,1">
            <hx:DefaultLights />
            <ModelVisual3D x:Name="ModelHost" />
        </hx:HelixViewport3D>

        <!-- Toolbar Overlay -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10" Background="#99000000">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
                <Style TargetType="ToggleButton">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
            </StackPanel.Resources>
            
            <Button Content="Perspective" Click="ViewPerspective_Click" />
            <Button Content="Top" Click="ViewTop_Click" />
            <Button Content="Front" Click="ViewFront_Click" />
            <Button Content="Right" Click="ViewRight_Click" />
            
            <Border Width="1" Background="#55FFFFFF" Margin="5,5" />
            
            <ToggleButton x:Name="MeasureToggle" Content="Measure (Off)" Click="MeasureToggle_Click" />
            <Button x:Name="ClearMeasureButton" Content="Clear" Click="ClearMeasure_Click" Visibility="Collapsed" />
        </StackPanel>

        <!-- Loading Overlay -->
        <Border x:Name="LoadingOverlay" Background="#80000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Extracting 3D Geometry..." Foreground="White" FontSize="18" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
